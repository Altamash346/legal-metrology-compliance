# ===========================================
# Legal Metrology Compliance Checker
# Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql+asyncpg://lmcc_user:lmcc_password@localhost:5432/lmcc_db
DATABASE_URL_SYNC=postgresql://lmcc_user:lmcc_password@localhost:5432/lmcc_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# OCR Configuration
OCR_ENGINE=paddleocr
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.70

# Admin Seed
ADMIN_EMAIL=admin@lmcc.gov.in
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator

# Optional: External AI API (for advanced field extraction)
# AI_API_KEY=
# AI_MODEL=
