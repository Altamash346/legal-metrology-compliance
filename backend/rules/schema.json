{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "rule_id": {"type": "string"},
      "title": {"type": "string"},
      "category": {"type": "string"},
      "field_name": {"type": "string"},
      "rule_type": {"type": "string", "enum": ["REQUIRED", "REGEX", "NUMERIC_RANGE", "DATE_RELATION", "TEXT_PATTERN", "CONDITIONAL", "QUANTITY_FORMAT", "PRICE_FORMAT", "FONT_SIZE", "CUSTOM"]},
      "condition": {"type": "object"},
      "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
      "legal_reference": {"type": "string"},
      "violation_message": {"type": "string"},
      "applicability": {"type": "object"},
      "is_active": {"type": "boolean"}
    },
    "required": ["rule_id", "title", "category", "field_name", "rule_type", "condition", "severity", "violation_message"]
  }
}
